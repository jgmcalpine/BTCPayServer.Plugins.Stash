@inject IScopeProvider ScopeProvider
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@model BatchHistoryViewModel
@{
    Layout = "_Layout";
    var storeId = ScopeProvider.GetCurrentStoreId();
    ViewData.SetActivePage("Stash", "Batch History", "Stash");
}

<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="my-1">@ViewData["Title"]</h2>
    <div class="d-flex gap-2 mt-3 mt-sm-0">
        <a asp-action="ExportCsv" asp-route-storeId="@storeId" 
           asp-route-from="@Model.FromDate?.ToString("yyyy-MM-dd")" 
           asp-route-to="@Model.ToDate?.ToString("yyyy-MM-dd")" 
           class="btn btn-secondary">
            <i class="fa fa-download"></i> Export CSV
        </a>
        <a asp-action="Index" asp-route-storeId="@storeId" class="btn btn-primary">
            <i class="fa fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<partial name="_StatusMessage" />

<!-- Date Filter -->
<div class="card mb-4 mt-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control" name="from" 
                       value="@Model.FromDate?.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-4">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control" name="to" 
                       value="@Model.ToDate?.ToString("yyyy-MM-dd")">
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Batches.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Fees</th>
                    <th>Net</th>
                    <th>Value</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var batch in Model.Batches)
                {
                    <tr>
                        <td>@batch.InitiatedAt.ToBrowserDate()</td>
                        <td>
                            <span class="badge @(batch.ExecutionType == BatchExecutionType.ColdStorage ? "bg-info" : "bg-warning")">
                                @(batch.ExecutionType == BatchExecutionType.ColdStorage ? "Cold Storage" : "Liquid Swap")
                            </span>
                        </td>
                        <td>@batch.TotalSats.ToString("N0") sats</td>
                        <td>@batch.FeeSats.ToString("N0") sats</td>
                        <td>@batch.NetSats.ToString("N0") sats</td>
                        <td>@batch.FiatValueAtExecution.ToString("N2") @batch.FiatCurrency</td>
                        <td>
                            <span class="badge @(batch.Status == BatchStatus.Completed ? "bg-success" : batch.Status == BatchStatus.Failed ? "bg-danger" : batch.Status == BatchStatus.Processing ? "bg-primary" : "bg-secondary")">
                                @batch.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="BatchDetail" asp-route-storeId="@storeId" asp-route-batchId="@batch.Id" 
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info mt-4">
        <i class="fa fa-info-circle"></i> No batches found for the selected period.
    </div>
}


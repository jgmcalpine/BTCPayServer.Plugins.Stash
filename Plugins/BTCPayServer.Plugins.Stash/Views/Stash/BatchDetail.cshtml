@inject IScopeProvider ScopeProvider
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@model BatchDetailViewModel
@{
    Layout = "_Layout";
    var storeId = ScopeProvider.GetCurrentStoreId();
    ViewData.SetActivePage("Stash", "Batch Details", "Stash");
    var batch = Model.Batch;
}

<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="my-1">Batch @batch.Id.Substring(0, 8)...</h2>
    <div class="d-flex gap-2 mt-3 mt-sm-0">
        @if (Model.CanRetry)
        {
            <form asp-action="RetryBatch" asp-route-storeId="@storeId" asp-route-batchId="@batch.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-primary" @(Model.HasAddressIssue ? "disabled" : "")>
                    <i class="fa fa-refresh"></i> Retry Batch
                </button>
            </form>
        }
        <a asp-action="Batches" asp-route-storeId="@storeId" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Back to History
        </a>
    </div>
</div>

<partial name="_StatusMessage" />

<div class="row mt-4">
    <!-- Batch Summary -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Batch Summary</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Status</span>
                    <span class="badge @(batch.Status == BatchStatus.Completed ? "bg-success" : batch.Status == BatchStatus.Failed ? "bg-danger" : "bg-secondary")">
                        @batch.Status
                    </span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Type</span>
                    <span>@(batch.ExecutionType == BatchExecutionType.ColdStorage ? "Cold Storage Sweep" : "Liquid Swap")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Initiated</span>
                    <span>@batch.InitiatedAt.ToBrowserDate()</span>
                </div>
                @if (batch.CompletedAt.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Completed</span>
                        <span>@batch.CompletedAt.Value.ToBrowserDate()</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Allocations</span>
                    <span>@batch.AllocationCount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Financial Details -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="mb-0">Financial Details</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Total Amount</span>
                    <span>@batch.TotalSats.ToString("N0") sats</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Network Fees</span>
                    <span>@batch.FeeSats.ToString("N0") sats</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Net Amount</span>
                    <span class="fw-bold">@batch.NetSats.ToString("N0") sats</span>
                </div>
                <hr>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Fiat Value</span>
                    <span>@batch.FiatValueAtExecution.ToString("N2") @batch.FiatCurrency</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Exchange Rate</span>
                    <span>@batch.ExchangeRateAtExecution.ToString("N2") @batch.FiatCurrency/BTC</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Avg Cost Basis</span>
                    <span>@batch.WeightedAverageCostBasis.ToString("N2") @batch.FiatCurrency/BTC</span>
                </div>
                @if (batch.ExecutionType == BatchExecutionType.LiquidSwap && batch.UsdtReceived.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">USDT Received</span>
                        <span class="fw-bold text-success">@batch.UsdtReceived.Value.ToString("N2") USDT</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Transaction Details -->
<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Transaction Details</h5>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(batch.DestinationAddress))
        {
            <div class="mb-3">
                <label class="form-label text-muted">Destination Address</label>
                <div class="font-monospace text-break">@batch.DestinationAddress</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(batch.TransactionId))
        {
            <div class="mb-3">
                <label class="form-label text-muted">Transaction ID</label>
                <div class="font-monospace text-break">
                    <a href="https://mempool.space/tx/@batch.TransactionId" target="_blank">
                        @batch.TransactionId
                    </a>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(batch.SwapId))
        {
            <div class="mb-3">
                <label class="form-label text-muted">Swap ID (Boltz)</label>
                <div class="font-monospace">@batch.SwapId</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(batch.ErrorMessage))
        {
            <div class="alert alert-danger mb-3">
                <h5 class="alert-heading"><i class="fa fa-exclamation-triangle"></i> Batch Failed</h5>
                <p class="mb-2">@batch.ErrorMessage</p>
                @if (Model.HasAddressIssue)
                {
                    <hr>
                    <p class="mb-2">
                        <strong>Current Issue:</strong> @Model.CurrentAddressError
                    </p>
                    <p class="mb-0">
                        <a asp-action="Settings" asp-route-storeId="@storeId" class="alert-link">
                            <i class="fa fa-cog"></i> Update your destination address in Settings
                        </a>
                        to fix this issue and retry the batch.
                    </p>
                }
                else if (Model.CanRetry)
                {
                    <hr>
                    <p class="mb-0">
                        You can attempt to retry this batch using the "Retry Batch" button above.
                    </p>
                }
            </div>
        }
        @if (Model.CanRetry && !string.IsNullOrEmpty(Model.NetworkType))
        {
            <div class="mb-3">
                <small class="text-muted">
                    <i class="fa fa-info-circle"></i> Running on <strong>@Model.NetworkType</strong> network
                </small>
            </div>
        }
    </div>
</div>

<!-- Source Allocations -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Source Allocations</h5>
    </div>
    @if (Model.Allocations.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Settled</th>
                        <th>Allocated</th>
                        <th>Cost Basis</th>
                        <th>Value at Receipt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alloc in Model.Allocations)
                    {
                        <tr>
                            <td>
                                <a href="/invoices/@alloc.InvoiceId" target="_blank">
                                    @alloc.InvoiceId
                                </a>
                            </td>
                            <td>@alloc.SettledAt.ToBrowserDate()</td>
                            <td>@alloc.AllocatedSats.ToString("N0") sats</td>
                            <td>@alloc.ExchangeRateAtReceipt.ToString("N2") @alloc.FiatCurrency/BTC</td>
                            <td>@alloc.FiatValueAtReceipt.ToString("N2") @alloc.FiatCurrency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body">
            <p class="text-muted mb-0">No allocation details available.</p>
        </div>
    }
</div>


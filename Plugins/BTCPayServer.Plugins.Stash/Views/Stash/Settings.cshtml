@inject IScopeProvider ScopeProvider
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Abstractions.Extensions
@model StashSettingsViewModel
@{
    Layout = "_Layout";
    var storeId = ScopeProvider.GetCurrentStoreId();
    ViewData.SetActivePage("Stash", "Stash Settings", "Stash");
}

<div class="sticky-header-setup"></div>
<div class="sticky-header d-sm-flex align-items-center justify-content-between">
    <h2 class="my-1">@ViewData["Title"]</h2>
    <a asp-action="Index" asp-route-storeId="@storeId" class="btn btn-secondary mt-3 mt-sm-0">
        <i class="fa fa-arrow-left"></i> Back to Dashboard
    </a>
</div>

<partial name="_StatusMessage" />

<div class="row mt-4">
    <div class="col-xl-8">
        <form asp-action="Settings" asp-controller="Stash" asp-route-storeId="@storeId" method="post" id="SettingsForm">
            
            <!-- Enable Toggle -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Plugin Status</h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" asp-for="IsEnabled" id="IsEnabled">
                        <label class="form-check-label" asp-for="IsEnabled">
                            Enable Stash for this store
                        </label>
                    </div>
                    <div class="text-muted mt-2">
                        When enabled, Stash will automatically track a portion of your settled invoices.
                    </div>
                </div>
            </div>

            <!-- Allocation Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Allocation Settings</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="AllocationPercentage" class="form-label"></label>
                            <div class="input-group">
                                <input type="number" class="form-control" asp-for="AllocationPercentage" 
                                       min="0" max="100" step="0.1">
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="AllocationPercentage" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Percentage of each invoice to virtually allocate (e.g., 20% for tax liability).
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="FiatCurrency" class="form-label"></label>
                            <select class="form-select" asp-for="FiatCurrency">
                                @foreach (var currency in StashSettingsViewModel.SupportedCurrencies)
                                {
                                    <option value="@currency" selected="@(Model.FiatCurrency == currency)">@currency</option>
                                }
                            </select>
                            <span asp-validation-for="FiatCurrency" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Currency used for threshold calculations.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Threshold Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Batch Threshold</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BatchThresholdFiat" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">@Model.FiatCurrency</span>
                                <input type="number" class="form-control" asp-for="BatchThresholdFiat" 
                                       min="1" step="1">
                            </div>
                            <span asp-validation-for="BatchThresholdFiat" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Batch execution triggers when pending allocations reach this fiat value.
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinimumBatchSats" class="form-label"></label>
                            <div class="input-group">
                                <input type="number" class="form-control" asp-for="MinimumBatchSats" 
                                       min="1000" step="1000">
                                <span class="input-group-text">sats</span>
                            </div>
                            <span asp-validation-for="MinimumBatchSats" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Minimum batch size to justify transaction fees.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Destination Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Destination</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="DestinationType" class="form-label"></label>
                        <select class="form-select" asp-for="DestinationType" id="DestinationType">
                            <option value="@((int)StashDestinationType.ColdStorage)">
                                Cold Storage (On-chain sweep - Non-taxable transfer)
                            </option>
                            <option value="@((int)StashDestinationType.LiquidSwap)">
                                Liquid Swap (BTC → USDT via Boltz - Taxable disposal)
                            </option>
                        </select>
                        <span asp-validation-for="DestinationType" class="text-danger"></span>
                    </div>

                    <div id="coldStorageOptions" style="display: none;">
                        <div class="mb-3">
                            <label asp-for="DestinationAddress" class="form-label">
                                Bitcoin Destination Address or XPUB
                            </label>
                            <input type="text" class="form-control" asp-for="DestinationAddress" 
                                   placeholder="bc1q... or xpub...">
                            <span asp-validation-for="DestinationAddress" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Bitcoin address for cold storage sweeps. Supports single addresses or XPUBs for address rotation.
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="FeeBlockTarget" class="form-label"></label>
                            <select class="form-select" asp-for="FeeBlockTarget">
                                <option value="1">~10 minutes (next block)</option>
                                <option value="3">~30 minutes (3 blocks)</option>
                                <option value="6">~1 hour (6 blocks)</option>
                                <option value="12">~2 hours (12 blocks)</option>
                                <option value="24">~4 hours (24 blocks)</option>
                                <option value="144">~1 day (144 blocks)</option>
                            </select>
                            <span asp-validation-for="FeeBlockTarget" class="text-danger"></span>
                        </div>
                    </div>

                    <div id="liquidSwapOptions" style="display: none;">
                        <div class="alert alert-warning mb-3">
                            <i class="fa fa-exclamation-triangle"></i>
                            <strong>Tax Implication:</strong> Swapping BTC to USDT is a taxable disposal event. 
                            Stash will record the cost basis for your accounting.
                        </div>
                        <div class="mb-3">
                            <label asp-for="LiquidAddress" class="form-label">
                                Liquid USDT Destination Address
                            </label>
                            <input type="text" class="form-control" asp-for="LiquidAddress" 
                                   placeholder="lq1... or ex1...">
                            <span asp-validation-for="LiquidAddress" class="text-danger"></span>
                            <div class="text-muted mt-1">
                                Liquid address where USDT will be sent after the swap. Must be a valid Liquid network address.
                            </div>
                        </div>
                        <div class="alert alert-info">
                            <i class="fa fa-info-circle"></i>
                            Liquid swap functionality uses the Boltz API.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Privacy Settings -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Privacy</h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" asp-for="UseTor" id="UseTor">
                        <label class="form-check-label" asp-for="UseTor">
                            Route API requests through Tor
                        </label>
                    </div>
                    <div class="text-muted mt-2">
                        Prevents IP leakage when communicating with external APIs (Boltz, rate providers).
                    </div>
                </div>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="submit" class="btn btn-primary" id="SaveSettings">
                    <i class="fa fa-save"></i> Save Settings
                </button>
            </div>
        </form>
    </div>

    <!-- Info Panel -->
    <div class="col-xl-4">
        <div class="card bg-light">
            <div class="card-header">
                <h5 class="mb-0"><i class="fa fa-info-circle"></i> How Stash Works</h5>
            </div>
            <div class="card-body">
                <ol class="mb-0">
                    <li class="mb-2">
                        <strong>Virtual Segregation:</strong> When an invoice is settled, Stash calculates your 
                        configured percentage and records it as a "pending allocation."
                    </li>
                    <li class="mb-2">
                        <strong>No On-chain Movement:</strong> Funds stay in your wallet. Stash only tracks 
                        the liability logically.
                    </li>
                    <li class="mb-2">
                        <strong>Threshold Monitoring:</strong> When pending allocations reach your fiat threshold, 
                        Stash triggers a batch execution.
                    </li>
                    <li class="mb-2">
                        <strong>Batch Execution:</strong> Depending on your destination type, funds are either 
                        swept to cold storage or swapped to stablecoin.
                    </li>
                    <li>
                        <strong>Cost Basis Tracking:</strong> Stash records the exchange rate at time of receipt 
                        for proper tax accounting.
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section PageFootContent {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const destType = document.getElementById('DestinationType');
            const coldOptions = document.getElementById('coldStorageOptions');
            const liquidOptions = document.getElementById('liquidSwapOptions');
            
            function updateVisibility() {
                if (destType.value === '@((int)StashDestinationType.ColdStorage)') {
                    coldOptions.style.display = 'block';
                    liquidOptions.style.display = 'none';
                } else {
                    coldOptions.style.display = 'none';
                    liquidOptions.style.display = 'block';
                }
            }
            
            destType.addEventListener('change', updateVisibility);
            updateVisibility();
        });
    </script>
}

